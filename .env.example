# Required — free tier, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Optional — defaults to gemini-flash-lite-latest
# GEMINI_MODEL=gemini-flash-lite-latest

# Auto-populated by Vercel when you attach a KV database to the project.
# Leave these unset locally; the app falls back to in-memory sessions.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
